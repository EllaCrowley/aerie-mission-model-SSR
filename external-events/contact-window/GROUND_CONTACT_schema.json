      "properties": {
        "passage_id": {
            "type": "string"
        },
        "passage_result_id": {
            "type": "string"
        },
        "satellite_id": {
            "type": "string"
        },
        "ground_station_id": {
            "type": "string"
        },
        "max_elevation": {
            "type": "number"
        },
        "aos": {
            "type": "string",
            "format": "date-time"
        },
        "tca": {
            "type": "string",
            "format": "date-time"
        },
        "los": {
            "type": "string",
            "format": "date-time"
        },
        "passage_status": {
            "type": "string"
        },
        "source": {
            "type": "string"
        },
        "keyhole_bypass": {
            "type": "boolean"
        }
      }
    }
  }
